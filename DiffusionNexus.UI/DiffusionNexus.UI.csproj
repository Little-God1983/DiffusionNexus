<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Force x64 codegen + RID. We deliberately do NOT set <Platforms> here:
         doing so changes VS's output path to bin\x64\<Config>\... which breaks
         the default debug profile and confuses CLI builds. PlatformTarget alone
         is sufficient to prevent BadImageFormatException from x64-only natives. -->
    <PlatformTarget>x64</PlatformTarget>
    <!-- Temporarily commented out to diagnose COR_E_EXECUTIONENGINE error -->
    <!-- <RuntimeIdentifier>win-x64</RuntimeIdentifier> -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>DiffusionNexus.UI</RootNamespace>
    <ApplicationIcon>Assets\AIKnowledgeIcon.ico</ApplicationIcon>
    <!-- Ensure all content (including Avalonia resources) is included in single-file publish -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <!-- LlamaSharp.Backend.Cpu ships multiple AVX variants with the same DLL names;
         allow publish to proceed instead of failing on NETSDK1152 -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**\*.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- The generated third-party index, read by Services/Licensing/ThirdPartyNotices.cs.
         An EmbeddedResource (not Content) so it survives single-file publish and always
         matches the binaries inside that exe. LogicalName is load-bearing: the loader asks
         for it by this exact name. Regenerate with Scripts/Generate-ThirdPartyNotices.ps1. -->
    <EmbeddedResource Include="..\third-party-notices.json" LogicalName="THIRD-PARTY-NOTICES.json" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Remove="Assets\Workflows\**" />
    <AvaloniaXaml Remove="Assets\Workflows\**" />
    <Compile Remove="Assets\Workflows\**" />
    <EmbeddedResource Remove="Assets\Workflows\**" />
    <None Remove="Assets\Workflows\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Dictionaries\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.13" />
    <PackageReference Include="Avalonia.Controls.PanAndZoom" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.13" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.13" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.13" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.13">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>none</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Skia" Version="11.3.13" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.13" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <!-- ItemsRepeater + UniformGridLayout power the virtualizing LoRA-viewer tile grid
         (only the tiles inside the viewport are realized, so 2K+ LoRAs open instantly
         and scroll smoothly). These types are NOT in core Avalonia 11.3.x; they ship in
         this standalone package, whose newest 11.x release is 11.1.5 (Avalonia published
         no 11.2/11.3 build of it). 11.1.5 resolves and runs against 11.3.13 core — the
         combo every 11.3.x consumer of ItemsRepeater necessarily uses. -->
    <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="11.1.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.*" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
    <PackageReference Include="DiffusionNexus.Installer.SDK.Models" Version="1.2.44" />
    <PackageReference Include="DiffusionNexus.Installer.SDK.Services" Version="1.2.44" />
    <PackageReference Include="DiffusionNexus.Installer.SDK.DataAccess" Version="1.2.44" />
    <PackageReference Include="DiffusionNexus.Installer.SDK.Shared" Version="1.2.44" />
    <PackageReference Include="DiffusionNexus.Installer.SDK.Database" Version="1.2.44" />
    <PackageReference Include="StableDiffusion.NET.Backend.Cuda12.Windows" Version="6.0.0" />
    <PackageReference Include="WeCantSpell.Hunspell" Version="7.0.1" />
    <!-- Pin transitive dependency to fix NU1903 (GHSA-xrw6-gwf8-vvr9) -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="LibVLCSharp" Version="3.10.0" />
    <PackageReference Include="LibVLCSharp.Avalonia" Version="3.10.0" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" Condition="'$(RuntimeIdentifier)' == 'win-x64' OR '$(OS)' == 'Windows_NT'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiffusionNexus.Domain\DiffusionNexus.Domain.csproj" />
    <ProjectReference Include="..\DiffusionNexus.DataAccess\DiffusionNexus.DataAccess.csproj" />
    <ProjectReference Include="..\DiffusionNexus.Infrastructure\DiffusionNexus.Infrastructure.csproj" />
    <ProjectReference Include="..\DiffusionNexus.Service\DiffusionNexus.Service.csproj" />
    <ProjectReference Include="..\DiffusionNexus.Inference\DiffusionNexus.Inference.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\InstallerManager\" />
    <Folder Include="ImageEditor\Events\" />
    <Folder Include="Tasks\" />
  </ItemGroup>

  <!-- LGPL-2.1 section 6 permits using these libraries only if the recipient can relink the work
       against a modified version of them. PublishSingleFile welds every managed assembly into the
       executable, where nothing can be replaced - so these four are kept out of the bundle and
       ship loose beside the exe, which the single-file host probes as a fallback.
       VideoLAN.LibVLC.Windows needs the same treatment and it is the easy one to get wrong: its
       payload arrives as Content, which lands loose in an ordinary build, so it looks replaceable
       already. It is not - _ComputeFilesToBundle consumes every ResolvedFileToPublish whatever its
       origin, so libvlc.dll, libvlccore.dll and all 323 plugins were being welded in as well.
       Guarded by DiffusionNexus.Tests/Licensing/LgplSingleFileComplianceTests.cs, which derives
       the required set from the generated notices so a new LGPL dependency cannot slip in. -->
  <ItemGroup>
    <LgplRelinkableAssembly Include="HPPH" />
    <LgplRelinkableAssembly Include="HPPH.SkiaSharp" />
    <LgplRelinkableAssembly Include="LibVLCSharp" />
    <LgplRelinkableAssembly Include="LibVLCSharp.Avalonia" />
    <LgplRelinkableContent Include="libvlc" />
  </ItemGroup>

  <!-- VideoLAN.LibVLC.Windows copies its payload for every architecture whose flag is unset, and
       with Platform=AnyCPU that means all three - 178 MB of win-x86 and win-arm64 binaries this
       app can never load, carrying the same GPL modules as the x64 set. The app is win-x64 only
       (the CUDA backend alone settles that), so the other two are switched off rather than
       shipped and attributed.
       x64 is pinned true rather than left implicit: the package enables it only when $(Platform)
       is x64 or AnyCPU, so a Platform=ARM64 build, an added Platforms element or a VS
       configuration change would switch x64 off while these two stay off - publishing an app
       with no libvlc at all, failing at runtime.
       TODO: Linux Implementation - a Linux build would use VideoLAN.LibVLC.Linux instead, whose
       payload has its own layout and its own licence audit; these three properties are specific
       to the Windows package and should be conditioned on the target OS when that lands. -->
  <PropertyGroup>
    <VlcWindowsX64Enabled>true</VlcWindowsX64Enabled>
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
    <VlcWindowsArm64Enabled>false</VlcWindowsArm64Enabled>
  </PropertyGroup>

  <!-- Four of the 323 win-x64 plugins are GPL rather than LGPL and are not on any path this app
       uses: an H.264 *encoder*, VLC's Lua bindings, and two optional audio filters that are only
       reachable if a user enables them. Dropping them removes the obligation instead of
       discharging it. libavcodec and libswscale are GPL too (FFmpeg built with GPL components
       enabled) and are NOT dropped: removing them was tested and breaks HEVC and MPEG-4/AVI
       playback, so those two are attributed in supplements.json instead.
       lua\** goes with liblua_plugin.dll: the package's default include set is
       libvlc.*;libvlccore.*;hrtfs\**;lua\**;plugins\**, so excluding only the plugin left 95
       files (1.1 MB) of VLC's HTTP web-interface behind, 16 of them plain GPL-2.0-or-later, that
       nothing can load once the Lua engine is gone.
       Guarded by DiffusionNexus.Tests/Licensing/VlcPayloadLicenseTests.cs, which re-derives the
       GPL set from every shipped file on each run and cross-checks it against
       Scripts/license-data/vlc-payload-audit.json. -->
  <ItemGroup>
    <VlcWindowsX64ExcludeFiles Include="plugins\codec\libx26410b_plugin.dll" />
    <VlcWindowsX64ExcludeFiles Include="plugins\lua\liblua_plugin.dll" />
    <VlcWindowsX64ExcludeFiles Include="plugins\audio_filter\libdolby_surround_decoder_plugin.dll" />
    <VlcWindowsX64ExcludeFiles Include="plugins\audio_filter\libheadphone_channel_mixer_plugin.dll" />
    <!-- %2A%2A, not **: the package's targets build their include/exclude paths through
         $([MSBuild]::Unescape(...)), so the wildcard must survive as escaped text until then.
         A literal ** is expanded by MSBuild when this item is declared - against this project's
         own directory, where no lua folder exists - so the item silently becomes empty and
         excludes nothing. The package's own include list is written lua\%2A%2A for that reason. -->
    <VlcWindowsX64ExcludeFiles Include="lua\%2A%2A" />
  </ItemGroup>

  <Target Name="KeepLgplAssembliesRelinkable" BeforeTargets="_ComputeFilesToBundle" AfterTargets="_HandleFileConflictsForPublish" Condition="'$(PublishSingleFile)' == 'true'">
    <PropertyGroup>
      <!-- Semicolon-delimited on both ends so the match is exact: a bare Contains would let
           "HPPH" also match "HPPH.SkiaSharp", and more importantly would match any future
           assembly whose name merely starts with a listed one. -->
      <_LgplRelinkableList>;@(LgplRelinkableAssembly);</_LgplRelinkableList>
    </PropertyGroup>
    <ItemGroup>
      <ResolvedFileToPublish Condition="'%(Extension)' == '.dll' And $([System.String]::Copy('$(_LgplRelinkableList)').Contains(';%(Filename);'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!-- Batched over LgplRelinkableContent so each directory gets an anchored StartsWith rather
       than a Contains that would also match a directory of that name nested anywhere below.
       TODO: Linux Implementation for Task LGPL-Relink-Content - the directory names are the
       Windows package's (libvlc\win-x64); a Linux payload lands elsewhere, so the item list is
       the extension point and the target itself needs no change. -->
  <Target Name="KeepLgplContentRelinkable" BeforeTargets="_ComputeFilesToBundle" AfterTargets="_HandleFileConflictsForPublish" Condition="'$(PublishSingleFile)' == 'true'" Outputs="%(LgplRelinkableContent.Identity)">
    <PropertyGroup>
      <_LgplContentDir>%(LgplRelinkableContent.Identity)</_LgplContentDir>
    </PropertyGroup>
    <ItemGroup>
      <ResolvedFileToPublish Condition="$([System.String]::Copy('%(RelativePath)').Replace('\','/').StartsWith('$(_LgplContentDir)/'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!-- LlamaSharp.Backend.Cpu ships duplicate native DLLs under avx / avx2 / avx512 / noavx.
       During single-file publish the bundler sees them all with the same BundleRelativePath
       and fails (MSB4018). This target strips the non-avx2 duplicates from
       ResolvedFileToPublish before _ComputeFilesToBundle feeds them to the bundler. -->
  <Target Name="DeduplicateLlamaSharpNatives" BeforeTargets="_ComputeFilesToBundle" AfterTargets="_HandleFileConflictsForPublish" Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(FullPath)').Replace('\','/').Contains('/llamasharp.backend.cpu/'))&#xD;&#xA;                     And !$([System.String]::Copy('%(FullPath)').Replace('\','/').Contains('/avx2/'))" />
    </ItemGroup>
  </Target>

  <!-- LLamaSharp 0.24.0 packaging workaround: ggml.dll in the cuda12 directory
       depends on ggml-cpu.dll but the CUDA package doesn't include it. Copy from CPU backend. -->
  <Target Name="FixCuda12MissingGgmlCpu" AfterTargets="Build" Condition="Exists('$(OutDir)runtimes\win-x64\native\cuda12\ggml.dll') And !Exists('$(OutDir)runtimes\win-x64\native\cuda12\ggml-cpu.dll')">
    <PropertyGroup>
      <_GgmlCpuSource Condition="Exists('$(OutDir)runtimes\win-x64\native\avx2\ggml-cpu.dll')">$(OutDir)runtimes\win-x64\native\avx2\ggml-cpu.dll</_GgmlCpuSource>
      <_GgmlCpuSource Condition="'$(_GgmlCpuSource)' == '' And Exists('$(OutDir)runtimes\win-x64\native\avx\ggml-cpu.dll')">$(OutDir)runtimes\win-x64\native\avx\ggml-cpu.dll</_GgmlCpuSource>
      <_GgmlCpuSource Condition="'$(_GgmlCpuSource)' == '' And Exists('$(OutDir)runtimes\win-x64\native\noavx\ggml-cpu.dll')">$(OutDir)runtimes\win-x64\native\noavx\ggml-cpu.dll</_GgmlCpuSource>
    </PropertyGroup>
    <Copy SourceFiles="$(_GgmlCpuSource)" DestinationFolder="$(OutDir)runtimes\win-x64\native\cuda12\" SkipUnchangedFiles="true" Condition="'$(_GgmlCpuSource)' != ''" />
    <Message Importance="high" Text="Copied ggml-cpu.dll to cuda12 backend directory (LLamaSharp workaround)" Condition="'$(_GgmlCpuSource)' != ''" />
  </Target>

  <!-- Microsoft.AI.DirectML ships DirectML.dll under bin\x64-win\ (non-standard layout),
       so the SDK never copies it to the output and it is missing from single-file bundles.
       OnnxRuntime.DirectML then fails to bind DirectML at first use, surfacing as
       System.BadImageFormatException at startup. Inject the x64 native into the publish
       items so it is copied next to onnxruntime.dll AND included in the single-file bundle.
       TODO: Linux Implementation for Task DirectML-Native-Inclusion (DirectML is Windows-only;
       gate this target on the win-x64 RID and add an equivalent abstraction when Linux ships). -->
  <Target Name="IncludeDirectMLNative" BeforeTargets="ResolveRuntimePackAssets;ComputeFilesToPublish;_ComputeFilesToBundle" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <PropertyGroup>
      <_DirectMLPackageDir>$(NuGetPackageRoot)microsoft.ai.directml\</_DirectMLPackageDir>
    </PropertyGroup>
    <ItemGroup>
      <_DirectMLCandidate Include="$(_DirectMLPackageDir)**\bin\x64-win\DirectML.dll" />
    </ItemGroup>
    <PropertyGroup>
      <_DirectMLDll>@(_DirectMLCandidate-&gt;'%(FullPath)'-&gt;Distinct())</_DirectMLDll>
    </PropertyGroup>
    <Warning Text="DirectML.dll not found under $(_DirectMLPackageDir). Microsoft.ML.OnnxRuntime.DirectML will fail at runtime with BadImageFormatException." Condition="'$(_DirectMLDll)' == ''" />
    <ItemGroup Condition="'$(_DirectMLDll)' != ''">
      <None Include="$(_DirectMLDll)">
        <Link>DirectML.dll</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <Visible>false</Visible>
      </None>
    </ItemGroup>
    <Message Importance="high" Text="Including DirectML.dll from $(_DirectMLDll)" Condition="'$(_DirectMLDll)' != ''" />
  </Target>
</Project>
