<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:DiffusionNexus.UI.ViewModels"
             xmlns:licensing="using:DiffusionNexus.UI.Services.Licensing"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650"
             x:Class="DiffusionNexus.UI.Views.AboutView"
             x:DataType="vm:AboutViewModel">

  <Design.DataContext>
    <vm:AboutViewModel/>
  </Design.DataContext>

  <Grid RowDefinitions="Auto,*">

    <!-- Identity -->
    <StackPanel Grid.Row="0" Margin="20,20,20,12" Spacing="8">
      <TextBlock Text="Diffusion Nexus" FontWeight="Bold" FontSize="28"/>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBlock Text="Build:" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding AppVersion}" FontStyle="Italic" FontSize="14"/>
      </StackPanel>
      <!-- The product's own licence. The screen below lists everyone else's terms; without this
           line it never states the terms this application itself is offered under. -->
      <TextBlock Text="Licensed under the MIT License. See LICENSE beside the executable."
                 FontSize="13" Opacity="0.85"/>
      <TextBlock TextWrapping="Wrap" FontWeight="Bold" Foreground="#FF6B6B">
        No Warranty: This software is provided 'as is', without any warranty of any kind, express or implied.
      </TextBlock>
    </StackPanel>

    <!-- Third-party software -->
    <Border Grid.Row="1" Margin="20,0,20,20" Padding="0" BorderBrush="#3C3C3C" BorderThickness="1" CornerRadius="4">
      <Grid RowDefinitions="Auto,Auto,*,Auto">

        <TextBlock Grid.Row="0" Margin="12,12,12,4"
                   Text="Third-party software" FontWeight="SemiBold" FontSize="16"/>

        <Grid Grid.Row="1" Margin="12,0,12,8" ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0"
                   Text="{Binding SearchText}"
                   Watermark="Search by package or licence (e.g. LGPL)"/>
          <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Opacity="0.7">
            <Run Text="{Binding Components.Count}"/>
            <Run Text="of"/>
            <Run Text="{Binding TotalComponentCount}"/>
          </TextBlock>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="260,Auto,*">

          <!-- Component list. ListBox virtualises by default, so a few hundred rows are fine. -->
          <ListBox Grid.Column="0"
                   Margin="12,0,0,12"
                   ItemsSource="{Binding Components}"
                   SelectedItem="{Binding SelectedComponent}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="licensing:ThirdPartyComponent">
                <StackPanel Margin="0,2">
                  <TextBlock Text="{Binding Id}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding License}" FontSize="11" Opacity="0.65"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <GridSplitter Grid.Column="1" Width="6" Background="Transparent" ResizeDirection="Columns"/>

          <!-- Detail for the selected component -->
          <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                        IsVisible="{Binding SelectedComponent, Converter={x:Static ObjectConverters.IsNotNull}}">
            <!-- Padding lives on this child, never on the ScrollViewer: ScrollViewer.Padding
                 makes the bottom 3x padding unreachable in Avalonia 11.3.x (PR #563). -->
            <StackPanel Margin="12,0,12,12" Spacing="6">
              <TextBlock Text="{Binding SelectedComponent.DisplayName}"
                         FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding SelectedComponent.License}" Opacity="0.8" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding SelectedComponent.Attribution}" Opacity="0.8" TextWrapping="Wrap"/>
              <Button Content="{Binding SelectedComponent.ProjectUrl}"
                      Command="{Binding OpenProjectUrlCommand}"
                      HorizontalAlignment="Left"
                      Padding="0" Background="Transparent" Foreground="#4FA3E3"
                      IsVisible="{Binding SelectedComponent.ProjectUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <Border Background="#1E1E1E" CornerRadius="3" Padding="10" Margin="0,6,0,0">
                <SelectableTextBlock Text="{Binding SelectedComponent.LicenseText}"
                                     FontFamily="Consolas,Menlo,monospace"
                                     FontSize="12"
                                     TextWrapping="Wrap"/>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <!-- Pointer to the flat notices file; absent in dev builds -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8"
                    Margin="12,0,12,12" VerticalAlignment="Center"
                    IsVisible="{Binding HasNoticesFile}">
          <TextBlock Text="The complete notices also ship as THIRD-PARTY-NOTICES.txt next to the application."
                     VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap"/>
          <Button Content="Open" Command="{Binding OpenNoticesFileCommand}"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
