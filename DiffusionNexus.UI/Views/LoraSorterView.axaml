<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiffusionNexus.UI.ViewModels"
             x:Class="DiffusionNexus.UI.Views.LoraSorterView"
             x:DataType="vm:LoraSorterViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.dimmed"><Setter Property="Opacity" Value="0.45"/></Style>
    <Style Selector="TextBlock.renamed"><Setter Property="Foreground" Value="#FFA726"/></Style>
    <Style Selector="TextBlock.skipped">
      <Setter Property="Opacity" Value="0.4"/>
      <Setter Property="TextDecorations" Value="Strikethrough"/>
    </Style>

    <!-- The row's own surface. Every one of these is a Setter rather than an attribute on the
         Border itself: a local value outranks a style, so setting Background="Transparent" inline
         would leave the .linked and .selected setters below with nothing to do. -->
    <Style Selector="Border.noderow">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Padding" Value="2,0"/>
    </Style>
    <Style Selector="Border.noderow:pointerover">
      <Setter Property="Background" Value="#14FFFFFF"/>
    </Style>
    <!-- Teal, because every other colour on this screen already means something: green/amber/red
         are the identity marks and orange is a rename. .selected comes after .linked so the row the
         user actually clicked wins when a file is somehow both. -->
    <Style Selector="Border.noderow.linked">
      <Setter Property="Background" Value="#234CC2D4"/>
      <Setter Property="BorderBrush" Value="#6B4CC2D4"/>
    </Style>
    <Style Selector="Border.noderow.selected">
      <Setter Property="Background" Value="#384CC2D4"/>
      <Setter Property="BorderBrush" Value="#FF4CC2D4"/>
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>

    <!-- One search box, used by both pane headers. Each pane owns its own instance and filters only
         its own tree: the two sides answer different questions, and a renamed file does not even
         carry the same name on both of them. -->
    <DataTemplate DataType="vm:SortPreviewFilterViewModel">
      <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
        <TextBlock Text="{Binding Summary}" FontSize="10.5" Opacity="0.5" VerticalAlignment="Center"
                   IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <TextBox Text="{Binding Text}" Watermark="Search…" Width="150" FontSize="11.5"
                 MinHeight="0" Padding="6,2" VerticalAlignment="Center"
                 ToolTip.Tip="Show only files and folders whose name contains this"/>
        <Button Content="✕" Command="{Binding ClearCommand}" Padding="6,1" FontSize="11"
                VerticalAlignment="Center" ToolTip.Tip="Clear the filter"
                IsVisible="{Binding Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vm:SortPreviewNodeViewModel">
      <!-- IsVisible is the pane's search box talking: true until a filter says otherwise, so an
           unfiltered tree draws exactly as it always did. -->
      <StackPanel IsVisible="{Binding IsVisible}">
        <!-- One template serves both trees. The two sides differ in exactly two places — the chips
             below are destination-only, and Note is written only on the source side — and both are
             a binding rather than a second template's worth of duplicated rows. -->
        <Border Classes="noderow"
                Classes.selected="{Binding IsSelected}"
                Classes.linked="{Binding IsLinked}"
                PointerPressed="OnPreviewRowPressed">
          <Border.ContextMenu>
            <!-- The menu inherits the row's node as its DataContext, so IsEnabled reads the node
                 and the handler takes it straight off the sender. No $parent hop: this template is
                 recursive, so the nearest ItemsControl is the folder above, not the view. -->
            <ContextMenu>
              <MenuItem Header="Open in folder" Click="OnOpenInFolder"
                        IsEnabled="{Binding CanOpenInFolder}"
                        ToolTip.Tip="Destination folders can only be opened once they exist"/>
            </ContextMenu>
          </Border.ContextMenu>
        <!-- The trailing columns are fixed-width so they line up down the pane. The indent goes on
             the row's own name rather than on the container holding its children: indenting the
             container moves the right edge in by 18px per level too, which is what left the chips,
             marks and sizes ragged. -->
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
          <Grid Grid.Column="0" ColumnDefinitions="18,*" Margin="{Binding Indent}">
            <ToggleButton Grid.Column="0" IsChecked="{Binding IsExpanded}"
                          Content="▸" Padding="2,0" Background="Transparent" BorderThickness="0"
                          IsVisible="{Binding !IsFile}"
                          ToolTip.Tip="Expand"/>
            <TextBlock Grid.Column="1" Text="{Binding Name}"
                       FontFamily="Consolas,monospace" FontSize="12" Margin="4,0,12,0"
                       VerticalAlignment="Center"
                       Classes.dimmed="{Binding IsAlreadyInPlace}"
                       Classes.renamed="{Binding IsRenamed}"
                       Classes.skipped="{Binding IsSkippedDuplicate}"/>
          </Grid>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
            <!-- "all 7 leave", "already here", "duplicate — skipped". Source side only: on the
                 destination side the folder is the answer and there is nothing to add. -->
            <TextBlock Text="{Binding Note}" FontSize="10.5" Opacity="0.5" Margin="0,0,2,0"
                       VerticalAlignment="Center"
                       IsVisible="{Binding Note, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <!-- Asset-kind chips: what is actually in this folder, rolled up through its subfolders.
                 Anything other than LoRA means the folder is about to receive something the sorter
                 is not really for — which is a question about a destination, so the source side does
                 not repeat it. -->
            <ItemsControl ItemsSource="{Binding AssetKinds}" IsVisible="{Binding !IsSourceSide}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="3"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#2F2F33" BorderBrush="#454549" BorderThickness="1"
                          CornerRadius="3" Padding="5,0,5,1">
                    <TextBlock Text="{Binding}" FontSize="10" Opacity="0.85"/>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
          <!-- Three marks, one visible at a time: read/confirmed, named-only, and no base model at
               all. The middle one exists because "sort by name" gives a guessed file a real folder,
               and a ✓ over "every file here has a base model" would then be a claim the preview
               cannot back. The fixed slot is what makes them a column rather than something that
               floats on however many chips happened to sit beside them. -->
          <Panel Grid.Column="2" Width="16" Margin="4,0,0,0">
            <TextBlock Text="✓" ToolTip.Tip="{Binding StatusTooltip}" Foreground="#6FCF7F"
                       FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"
                       IsVisible="{Binding IsIdentified}"/>
            <TextBlock Text="~" ToolTip.Tip="{Binding StatusTooltip}" Foreground="#E2B14C"
                       FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"
                       IsVisible="{Binding IsGuessed}"/>
            <TextBlock Text="✗" ToolTip.Tip="{Binding StatusTooltip}" Foreground="#FF6B6B"
                       FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"
                       IsVisible="{Binding IsUnidentified}"/>
          </Panel>
          <!-- Count and size are separate columns, so a folder's "12 LoRAs" cannot push its size
               out of line with the file sizes underneath it. -->
          <TextBlock Grid.Column="3" Text="{Binding CountDisplay}" FontSize="11" Opacity="0.5"
                     Width="72" TextAlignment="Right" Margin="6,0,0,0" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="4" Text="{Binding SizeDisplay}" FontSize="11" Opacity="0.5"
                     Width="72" TextAlignment="Right" Margin="6,0,0,0" VerticalAlignment="Center"/>
        </Grid>
        </Border>
        <ItemsControl ItemsSource="{Binding Children}"
                      IsVisible="{Binding IsExpanded}"/>
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Headline -->
    <Border Grid.Row="0" Background="#1E1E1E" Padding="16,12" BorderBrush="#333" BorderThickness="0,0,0,1">
      <StackPanel Spacing="2">
        <TextBlock Text="Sort your LoRAs" FontSize="18" FontWeight="Bold"/>
        <TextBlock Text="Reorganize your LoRA library into clean folders by base model and category."
                   FontSize="12" Opacity="0.6"/>
      </StackPanel>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="300,*">

      <!-- Options rail -->
      <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#333" BorderThickness="0,0,1,0" Padding="16,14">
        <StackPanel Spacing="14">

          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="fieldLabel" Text="SOURCE FOLDER" FontSize="11" Opacity="0.6"
                         VerticalAlignment="Center"/>
              <Button Grid.Column="1" Command="{Binding RefreshCommand}"
                      Background="#2A2A2A" BorderBrush="#333" BorderThickness="1" Padding="6,2"
                      ToolTip.Tip="Re-scan the source folder and refresh the preview">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <TextBlock Text="&#x21BB;" FontSize="11"/>
                  <TextBlock Text="Refresh" FontSize="11"/>
                </StackPanel>
              </Button>
            </Grid>
            <ComboBox ItemsSource="{Binding SourceFolders}"
                      SelectedItem="{Binding SelectedSourceFolder}"
                      HorizontalAlignment="Stretch"/>
            <Button Content="Browse any folder…" Command="{Binding BrowseSourceCommand}"
                    HorizontalAlignment="Stretch" FontSize="12"/>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Classes="fieldLabel" Text="TARGET FOLDER" FontSize="11" Opacity="0.6"/>
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis">
                <TextBlock.Text>
                  <Binding Path="CustomTargetFolder" TargetNullValue="Same as source"/>
                </TextBlock.Text>
              </TextBlock>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                <Button Content="…" Command="{Binding BrowseTargetCommand}"/>
                <Button Content="✕" Command="{Binding ClearTargetOverrideCommand}"
                        IsVisible="{Binding CustomTargetFolder, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              </StackPanel>
            </Grid>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Classes="fieldLabel" Text="FOLDER STRUCTURE" FontSize="11" Opacity="0.6"/>
            <RadioButton GroupName="Structure" Content="Base model only"
                         IsChecked="{Binding !IncludeCategory}"/>
            <RadioButton GroupName="Structure" Content="Base model + category"
                         IsChecked="{Binding IncludeCategory}"/>
            <!-- Sits under the structure radios because "already in the right folder" is decided by
                 whichever of them is selected. View-only: a settled file was never going to be
                 touched, so hiding it changes nothing about the run. -->
            <CheckBox Content="Hide files already in the right folder"
                      IsChecked="{Binding IgnoreFilesAlreadyInPlace}" FontSize="12"
                      ToolTip.Tip="Leaves only the files the run would actually move. The summary still says how many were hidden."/>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Classes="fieldLabel" Text="UNIDENTIFIED LORAS" FontSize="11" Opacity="0.6"/>
            <CheckBox Content="Sort by name when nothing else identifies a LoRA"
                      IsChecked="{Binding GuessBaseModelFromFileName}" FontSize="12"/>
            <TextBlock Text="{Binding NameGuessHint}" FontSize="11.5" Opacity="0.75"
                       TextWrapping="Wrap"
                       IsVisible="{Binding NameGuessHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Classes="fieldLabel" Text="OPERATION" FontSize="11" Opacity="0.6"/>
            <RadioButton GroupName="Operation" Content="Move (reorganize)" IsChecked="{Binding IsMove}"/>
            <RadioButton GroupName="Operation" Content="Copy (duplicate)" IsChecked="{Binding !IsMove}"/>
          </StackPanel>

          <Border Background="#2A2A2A" BorderBrush="#444" BorderThickness="1" CornerRadius="4"
                  Padding="8,6" IsVisible="{Binding IsMove}">
            <TextBlock Text="⚠ Move rearranges your files on disk — the old folder structure cannot be restored automatically."
                       Foreground="#FFA726" FontSize="11.5" TextWrapping="Wrap"/>
          </Border>

          <CheckBox Content="Delete empty source folders"
                    IsChecked="{Binding DeleteEmptySourceFolders}"
                    IsEnabled="{Binding IsMove}" FontSize="12"/>

          <Border Background="#252526" BorderBrush="#333" BorderThickness="1" CornerRadius="4" Padding="8,6">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding DiskSummary}" FontSize="12"/>
              <TextBlock Text="{Binding BlockReason}" Foreground="#FF6B6B" FontSize="11.5"
                         TextWrapping="Wrap"
                         IsVisible="{Binding BlockReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
          </Border>

          <Button Command="{Binding StartSortingCommand}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Background="#2D7D46" Foreground="White" FontWeight="SemiBold" Padding="0,8">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="▶"/>
              <TextBlock Text="{Binding TransferCount, StringFormat='Start Sorting ({0} files)'}"/>
            </StackPanel>
          </Button>

        </StackPanel>
      </Border>

      <!-- Folder structure preview: the library as it is now beside the library as it would be.
           Both trees are built from the same plan, so they can never describe different ones. -->
      <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">

        <!-- Preview toolbar. One order for both trees — they exist to be compared row against row,
             and two panes sorted differently would defeat that — so it sits above both rather than
             in either pane's header. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6"
                    HorizontalAlignment="Right" Margin="8,10,16,0">
          <TextBlock Text="Sort" FontSize="11" Opacity="0.6" VerticalAlignment="Center"/>
          <!-- MinWidth and no MinHeight override, matching the Civitai browser's pickers: a
               ComboBox squeezed to MinHeight="0" collapses to a sliver nobody can see. -->
          <ComboBox ItemsSource="{Binding SortOrders}"
                    SelectedItem="{Binding PreviewSortOrder, Mode=TwoWay}"
                    MinWidth="110" FontSize="11.5"
                    ToolTip.Tip="Orders the rows inside every folder of both trees. Default is the order the plan produced."/>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*">

          <Grid Grid.Column="0" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="16,14,8,6">
              <TextBlock Grid.Column="0" Text="SOURCE (NOW)" FontSize="11" Opacity="0.6"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="1" Text="{Binding SelectedSourceFolder}"
                         FontFamily="Consolas,monospace"
                         FontSize="10.5" Opacity="0.35" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"/>
              <ContentControl Grid.Column="2" Content="{Binding SourceFilter}"/>
            </Grid>
            <ScrollViewer Grid.Row="1" Padding="16,0,6,0" HorizontalScrollBarVisibility="Auto">
              <ItemsControl x:Name="SourceTree" ItemsSource="{Binding SourceRoots}"/>
            </ScrollViewer>
            <TextBlock Grid.Row="1" Text="No files match" Margin="16,4,0,0"
                       FontSize="11.5" Opacity="0.45" VerticalAlignment="Top"
                       IsVisible="{Binding SourceFilter.HasNoMatches}"/>
          </Grid>

          <GridSplitter Grid.Column="1" Width="6" Background="#242427"
                        ResizeDirection="Columns"
                        ToolTip.Tip="Drag to give either side more room"/>

          <Grid Grid.Column="2" RowDefinitions="Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="8,14,16,6">
              <TextBlock Grid.Column="0" Text="AFTER SORTING" FontSize="11" Opacity="0.6"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Grid.Column="1" Text="{Binding EffectiveTargetRoot}"
                         FontFamily="Consolas,monospace"
                         FontSize="10.5" Opacity="0.35" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"/>
              <ContentControl Grid.Column="2" Content="{Binding TargetFilter}"/>
            </Grid>
            <ScrollViewer Grid.Row="1" Padding="6,0,16,0" HorizontalScrollBarVisibility="Auto">
              <ItemsControl x:Name="TargetTree" ItemsSource="{Binding PreviewRoots}"/>
            </ScrollViewer>
            <TextBlock Grid.Row="1" Text="No files match" Margin="6,4,0,0"
                       FontSize="11.5" Opacity="0.45" VerticalAlignment="Top"
                       IsVisible="{Binding TargetFilter.HasNoMatches}"/>
          </Grid>

        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding PreviewSummary}" Margin="16,8,16,12"
                   FontSize="12" Opacity="0.85"/>
      </Grid>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="2" Background="#1E1E1E" Padding="8,4" BorderBrush="#333" BorderThickness="0,1,0,0"
            IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding StatusMessage}" Opacity="0.8" FontSize="12"/>
    </Border>

    <!-- Busy overlay (same convention as the Installed tab) -->
    <Border Grid.Row="0" Grid.RowSpan="3" Background="#CC000000" IsVisible="{Binding IsBusy}">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
        <ProgressBar IsIndeterminate="True" Width="300"/>
        <TextBlock Text="{Binding BusyMessage}" HorizontalAlignment="Center"/>
        <Button Content="Cancel" Command="{Binding CancelSortCommand}" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
