<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiffusionNexus.UI.ViewModels.DiffusionCanvas"
             xmlns:controls="using:DiffusionNexus.UI.Views.Controls"
             x:Class="DiffusionNexus.UI.Views.DiffusionCanvas.DiffusionCanvasView"
             x:DataType="vm:DiffusionCanvasViewModel">
  <Design.DataContext>
    <vm:DiffusionCanvasViewModel/>
  </Design.DataContext>
  <Grid RowDefinitions="Auto,*,Auto,Auto">

    <!-- ─────────────────────────── Toolbar ─────────────────────────── -->
    <Border Grid.Row="0" Background="#1E1E1E" Padding="8" BorderBrush="#333" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="True">
        <ContentControl DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                        IsVisible="{Binding ResourceMonitor, Converter={x:Static ObjectConverters.IsNotNull}}">
          <controls:ResourceMonitorView DataContext="{Binding ResourceMonitor}" />
        </ContentControl>

        <StackPanel Orientation="Horizontal" Spacing="4">
          <ComboBox MinWidth="220"
                    ItemsSource="{Binding AvailableBackends}"
                    SelectedItem="{Binding SelectedBackend}"
                    ToolTip.Tip="Which engine generates the image">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:CanvasBackendOption">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ComboBox MinWidth="220"
                    ItemsSource="{Binding AvailableModels}"
                    SelectedItem="{Binding SelectedModel}"
                    ToolTip.Tip="The model this backend will load and run.">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:CanvasModelOption">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button Content="Unload" Command="{Binding UnloadModelCommand}"
                  ToolTip.Tip="Free VRAM by unloading the resident model (the next Generate reloads it)." />

          <Separator Margin="6,0" />

          <Button Content="Fit" Click="OnFitClicked"
                  ToolTip.Tip="Frame everything on the canvas (F)" />
          <Button Content="1:1" Click="OnOneToOneClicked"
                  ToolTip.Tip="Zoom to one generated pixel per screen pixel (1)" />
          <Button Content="Find box" Click="OnCenterBoxClicked"
                  ToolTip.Tip="Centre the view on the generation box (B)" />
          <ToggleButton Content="Grid" IsChecked="{Binding ShowGrid}"
                        ToolTip.Tip="Show the dot grid (G)" />
          <TextBlock Name="ZoomReadout" VerticalAlignment="Center" Foreground="#999"
                     Margin="6,0,0,0" MinWidth="52" />

          <Separator Margin="6,0" />

          <Button Content="Clear canvas" Command="{Binding ClearCanvasCommand}"
                  ToolTip.Tip="Remove every accepted result from the canvas." />

          <Separator Margin="6,0" />

          <Button Content="+ LoRA" Command="{Binding AddLoraCommand}" IsEnabled="False"
                  ToolTip.Tip="TODO(v2-loras): Add a LoRA over the base model." />
          <Button Content="+ ControlNet" Command="{Binding AddControlNetCommand}" IsEnabled="False"
                  ToolTip.Tip="TODO(v2-controlnet): Add ControlNet conditioning input." />
          <Button Content="Mask" Command="{Binding ActivateMaskToolCommand}" IsEnabled="False"
                  ToolTip.Tip="TODO(v2-mask-tools): Inpaint mask painting (issue #518 region D)." />
          <Button Content="Layers" Command="{Binding ToggleLayerPanelCommand}" IsEnabled="False"
                  ToolTip.Tip="TODO(v2-layers): Layer stack (issue #518 region D)." />

          <Separator Margin="6,0" />
          <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Foreground="#CCC" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ─────────────────────────── Canvas surface ─────────────────────────── -->
    <controls:DiffusionCanvasSurface Grid.Row="1"
                                     Name="Surface"
                                     Rasters="{Binding Frames}"
                                     Box="{Binding Box}"
                                     ShowGrid="{Binding ShowGrid}"
                                     PreviewImage="{Binding Staging.CurrentImage}"
                                     PreviewRect="{Binding Staging.CurrentRect}"
                                     IsPreviewHidden="{Binding Staging.IsComparing}"
                                     SpacePanEnabled="{Binding !Staging.HasCandidates}" />

    <!-- ─────────────────────────── Staging strip ─────────────────────────── -->
    <Border Grid.Row="2" Background="#1B1B1B" BorderBrush="#333" BorderThickness="0,1,0,0"
            Padding="8,6" IsVisible="{Binding Staging.HasCandidates}">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                    Margin="0,0,10,0">
          <TextBlock Text="Staging" Foreground="#DDD" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Staging.PositionText}" Foreground="#888" VerticalAlignment="Center"
                     Margin="4,0,0,0" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                    Margin="10,0,0,0">
          <Button Content="&#x2190;" Command="{Binding Staging.PreviousCommand}"
                  ToolTip.Tip="Previous candidate (Left arrow)" />
          <Button Content="&#x2192;" Command="{Binding Staging.NextCommand}"
                  ToolTip.Tip="Next candidate (Right arrow)" />
          <Button Content="Accept" Command="{Binding Staging.AcceptCommand}"
                  Background="#2D7D46" Foreground="White"
                  ToolTip.Tip="Place this candidate on the canvas (Enter)" />
          <Button Content="Discard" Command="{Binding Staging.DiscardCommand}"
                  ToolTip.Tip="Throw this candidate away (Delete)" />
          <Button Content="Accept all" Command="{Binding Staging.AcceptAllCommand}" />
          <Button Content="Discard all" Command="{Binding Staging.DiscardAllCommand}" />
        </StackPanel>

        <ListBox Name="StagingList"
                 ItemsSource="{Binding Staging.Candidates}"
                 SelectedItem="{Binding Staging.Current}"
                 SelectionMode="Single"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:StagedCandidateViewModel">
              <Grid Width="86" Height="86">
                <Border Background="#101010" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="3">
                  <Image Source="{Binding Image}" Stretch="Uniform" />
                </Border>
                <!-- Slots for results still rendering, dimmed. -->
                <Border Background="#B0101010" CornerRadius="3" IsVisible="{Binding IsPending}">
                  <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="{Binding StatusText}" Foreground="#BBB" FontSize="10"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="4,0" />
                    <ProgressBar Width="60" Height="4" IsIndeterminate="True" />
                  </StackPanel>
                </Border>
                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#CC000000"
                        CornerRadius="3,0,3,0" Padding="4,1">
                  <TextBlock Text="{Binding Ordinal}" Foreground="#DDD" FontSize="10" />
                </Border>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ─────────────────────────── Prompt + Generate ─────────────────────────── -->
    <Border Grid.Row="3" Background="#1E1E1E" Padding="8" BorderBrush="#333" BorderThickness="0,1,0,0">
      <StackPanel Spacing="6">
        <Border Background="#5A2020" CornerRadius="4" Padding="8"
                IsVisible="{Binding BackendUnavailableMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="{Binding BackendUnavailableMessage}" Foreground="#FFD" TextWrapping="Wrap" />
        </Border>

        <TextBox Name="PromptBox" Text="{Binding PromptText}"
                 Watermark="Prompt - describe the image to generate"
                 AcceptsReturn="True" MaxHeight="80" />
        <TextBox Text="{Binding NegativePromptText}"
                 Watermark="Negative prompt - coming soon (TODO(v2-negative-prompt))"
                 IsEnabled="False" MaxHeight="60" />

        <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto">
          <TextBlock Grid.Column="0" Text="{Binding RegionModeText}" Foreground="#9AC" VerticalAlignment="Center"
                     TextWrapping="Wrap"
                     ToolTip.Tip="Whatever is under the box is what the model sees. Drag the box onto a result to make this an image-to-image run." />

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0"
                      VerticalAlignment="Center" IsVisible="{Binding IsRegionOccupied}">
            <TextBlock Text="Denoise:" VerticalAlignment="Center" Foreground="#BBB" />
            <Slider Width="120" Minimum="0.05" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True"
                    Value="{Binding DenoiseStrength}" VerticalAlignment="Center"
                    ToolTip.Tip="How far from the pixels under the box the result may travel. 0 keeps the input, 1 ignores it." />
            <TextBlock Text="{Binding DenoiseStrength, StringFormat={}{0:0.00}}" Foreground="#BBB"
                       VerticalAlignment="Center" MinWidth="30" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="12,0,8,0"
                      VerticalAlignment="Center">
            <TextBlock Text="Batch:" VerticalAlignment="Center" Foreground="#BBB" />
            <NumericUpDown Value="{Binding BatchCount}" Minimum="1" Maximum="8" Increment="1" Width="90"
                           FormatString="0"
                           ToolTip.Tip="How many candidates one Generate produces. They run one after another — the engine keeps a single model resident." />
          </StackPanel>

          <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="14,6"
                    ToolTip.Tip="Stop the batch. The engine (ComfyUI) is interrupted immediately; the local backend finishes the image it is sampling and discards it, because stable-diffusion.cpp exposes no mid-sample cancel hook." />
            <Button Content="Generate" Command="{Binding GenerateCommand}"
                    Padding="20,6" FontWeight="SemiBold"
                    Background="#0E639C" Foreground="White" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
