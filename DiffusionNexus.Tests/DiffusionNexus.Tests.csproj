<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaXaml Remove="UI\**" />
    <Compile Remove="UI\**" />
    <EmbeddedResource Remove="UI\**" />
    <None Remove="UI\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="11.3.13" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Pinned to 7.2.2 deliberately. FluentAssertions 8.0 relicensed to the Xceed
         licence: free for open-source/non-commercial, PAID for commercial use with no
         revenue threshold. Being test-only is not an exemption — it is a use licence,
         not a distribution licence. 7.2.2 is the last Apache-2.0 release. Do not bump
         to 8.x without buying a licence. Same pin as DiffusionNexus.Installer.SDK and
         DiffusionNexus.Installers. -->
    <PackageReference Include="FluentAssertions" Version="7.2.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiffusionNexus.DataAccess\DiffusionNexus.DataAccess.csproj" />
    <ProjectReference Include="..\DiffusionNexus.Service\DiffusionNexus.Service.csproj" />
    <ProjectReference Include="..\DiffusionNexus.UI\DiffusionNexus.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Captioning\" />
    <Folder Include="LoraSort\UI\" />
    <Folder Include="LoraSort\ViewModels\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\DiffusionNexus.UI\Assets\Pipelines\batch-metadata-distiller.json" Link="TestData\batch-metadata-distiller.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\DiffusionNexus.UI\Assets\Pipelines\Krea2-Text2Image-API.json" Link="TestData\Krea2-Text2Image-API.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
