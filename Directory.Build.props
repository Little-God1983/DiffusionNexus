<Project>
  <PropertyGroup>
    <!-- Version: Major.Minor.Build.Revision. Not bumped by hand: a merge into main releases the
         next version, counted up from the last vX.Y.Z tag (feat: raises Minor, anything else Build),
         and Scripts\build.ps1 stamps the same one. Major.Minor.Build here is only a floor - raise
         it in a PR to jump, say to 1.0.0. See .github/workflows/release.yml. -->
    <Version>0.12.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <!-- Prevent Git commit hash from being appended to version -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- Assembly metadata (helps with AV reputation / removes "Unknown publisher") -->
    <Company>Into The Latent</Company>
    <Authors>Christian Wenzl</Authors>
    <Product>DiffusionNexus</Product>
    <Description>Local AI model and dataset manager.</Description>
    <Copyright>Copyright © Into The Latent $([System.DateTime]::Now.Year)</Copyright>
  </PropertyGroup>
</Project>
