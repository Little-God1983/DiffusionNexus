#!/bin/sh
# Enforces branch naming convention and blocks direct pushes to protected branches.
# Allowed patterns: main, develop, feature/*, bugfix/*, hotfix/*, release/*
# (bug/* is still accepted only so branches created before bugfix/ can be pushed; new branches use bugfix/)
# Protected branches (require PR): main, develop
#
# Checks every branch the push writes TO (the remote refs git passes on stdin), not the
# checked-out branch: `git push origin HEAD:develop` from a feature branch is caught too.
# Tags and other non-branch refs are not checked.

valid_pattern='^(main|develop|feature/.+|bugfix/.+|bug/.+|hotfix/.+|release/.+)$'
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/*) branch=${remote_ref#refs/heads/} ;;
    *) continue ;;
  esac

  # Block direct pushes to protected branches
  if [ "$branch" = "main" ] || [ "$branch" = "develop" ]; then
    echo ""
    echo "  ERROR: Direct push to '$branch' is not allowed."
    echo "  Please create a feature branch and submit a pull request."
    echo ""
    status=1
    continue
  fi

  if ! printf '%s\n' "$branch" | grep -qE "$valid_pattern"; then
    echo ""
    echo "  ERROR: Branch name '$branch' does not follow the naming convention."
    echo ""
    echo "  Allowed prefixes:"
    echo "    main"
    echo "    develop"
    echo "    feature/<name>    e.g. feature/wizard-ui"
    echo "    bugfix/<name>     e.g. bugfix/taskbar-null-ref"
    echo "    hotfix/<name>     e.g. hotfix/crash-on-install"
    echo "    release/<version> e.g. release/1.3.0"
    echo ""
    if [ "$local_ref" = "refs/heads/$branch" ]; then
      echo "  Rename your branch first:"
      echo "    git branch -m $branch <correct-name>"
    else
      echo "  Push it under a correct name instead, e.g.:"
      echo "    git push <remote> <local-branch>:feature/<name>"
    fi
    echo ""
    status=1
  fi
done

exit $status
